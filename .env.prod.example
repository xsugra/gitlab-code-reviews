# =============================================================================
# CODE REVIEW BOT — Production Configuration
# =============================================================================
# Copy this file to .env and fill in the values below.
#
# Only bootstrap settings live here. Everything operational — GitLab URL/token,
# Ollama model & tuning, chunk size, webhook secret, re-trigger emoji — is
# configured in the admin UI at /code-review-bot/settings and stored in the
# database. On first boot the optional values at the bottom are seeded into the
# DB if present; after that the DB is the source of truth.
#
# Architecture:
#   PC 1 (GITLAB_PC_IP)  — GitLab instance
#   PC 2 (BOT_PC_IP)     — Code Review Bot + Ollama
# =============================================================================


# ==========================
# Admin UI auth
# ==========================
# The admin dashboard is gated by a single shared password (no OAuth).
# The machine is expected to be on a trusted, non-public network.

# Password to sign in to the admin UI.
ADMIN_PASSWORD=change-me

# Secret key for signing session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=


# ==========================
# Logging
# ==========================
# Applied once at startup. Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# ==========================
# Database
# ==========================
# Path INSIDE the container. Mapped via docker-compose volume.
# Do not change unless you also change docker-compose.yml volumes.
DB_PATH=/data/reviews.db


# =============================================================================
# Optional first-boot seed values
# -----------------------------------------------------------------------------
# Uncomment to pre-populate the database on first run. Afterwards, manage these
# from the admin UI (/code-review-bot/settings). Safe to delete once seeded.
# =============================================================================

# GitLab URL as seen from the BOT server (server-to-server API calls).
# GITLAB_URL=http://<GITLAB_PC_IP>:<GITLAB_PORT>

# GitLab Personal/Project Access Token with the `api` scope (prefix glpat-).
# Generate at: http://<GITLAB_PC_IP>:<GITLAB_PORT>/-/user_settings/personal_access_tokens
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Webhook secret token. Must match the "Secret Token" on the GitLab webhook.
# GITLAB_WEBHOOK_SECRET=

# Ollama endpoint and model (pull the model first with `ollama pull <model>`).
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5-coder:14b-instruct-q8_0
# OLLAMA_NUM_CTX=32768
# OLLAMA_TEMPERATURE=0.2
# OLLAMA_TIMEOUT_S=1800

# Max characters per LLM input chunk (~4 chars/token).
# MAX_CHUNK_CHARS=80000

# GitLab emoji name (no colons) that re-triggers a review when added to an MR.
# REVIEW_RETRIGGER_EMOJI=repeat
