# =============================================================================
# CODE REVIEW BOT — Production Configuration
# =============================================================================
# Copy this file to .env and fill in all values.
#
# Architecture:
#   PC 1 (GITLAB_PC_IP)  — GitLab instance
#   PC 2 (BOT_PC_IP)     — Code Review Bot + Ollama
#
# Replace these placeholders throughout the file:
#   <GITLAB_PC_IP>  — IP address of the PC running GitLab (e.g. 192.168.1.10)
#   <BOT_PC_IP>     — IP address of the PC running the bot (e.g. 192.168.1.20)
#   <GITLAB_PORT>   — Port where GitLab is accessible (e.g. 8088, 80, or 443)
# =============================================================================


# ==========================
# GitLab Connection
# ==========================

# Full URL of your GitLab instance as seen from the BOT server.
# This is used for API calls (server-to-server).
GITLAB_URL=http://<GITLAB_PC_IP>:<GITLAB_PORT>

# GitLab Personal Access Token or Project Access Token.
# Required scopes: api (for reading MRs and posting comments)
# Generate at: http://<GITLAB_PC_IP>:<GITLAB_PORT>/-/user_settings/personal_access_tokens
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Webhook secret token. Must match the "Secret Token" field configured
# on the GitLab webhook. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
GITLAB_WEBHOOK_SECRET=

# ---
# GitLab Webhook Triggers (enable in GitLab webhook settings):
#   [x] Merge request events  — code review + auto-fill empty MR descriptions
#   [x] Push events           — review commits pushed directly to branches
#   [x] Pipeline events       — analyze failed CI/CD pipelines
#   [x] Work item events      — auto-triage new issues (labels + severity)
#   [x] Deployment events      — analyze failed/successful deployments
#   [x] Releases events       — generate release notes from merged MRs
#   [x] Tag push events       — generate release notes when a tag is pushed
#   [x] Emoji events          — re-trigger review when specific emoji is added to MR


# ==========================
# Ollama / LLM
# ==========================

# URL where Ollama is running. If Ollama runs on the same PC as the bot:
#   - From inside Docker: http://host.docker.internal:11434
#   - If Ollama is on a different PC: http://<OLLAMA_PC_IP>:11434
OLLAMA_URL=http://host.docker.internal:11434

# Model to use for code reviews. Must be pulled first:

# Pull the model first: `docker compose exec ollama ollama pull qwen2.5-coder:14b-instruct-q8_0`
# Or locally on your machine: `ollama pull qwen2.5-coder:14b-instruct-q8_0`
OLLAMA_MODEL=qwen2.5-coder:14b-instruct-q8_0

# Context window size in tokens. Match your model's capability.
# qwen2.5-coder:14b-instruct-q8_0 supports up to 32768.
OLLAMA_NUM_CTX=32768

# LLM temperature (0.0 = deterministic, 1.0 = creative). Low is better for code review.
OLLAMA_TEMPERATURE=0.2

# Timeout in seconds for a single LLM request. Large MRs on CPU can be slow.
# 1800 = 30 minutes. Increase if you run on CPU without GPU.
OLLAMA_TIMEOUT_S=1800


# ==========================
# Chunking
# ==========================

# Max characters per LLM input chunk.
# ~4 chars/token → 80000 chars ≈ 20k tokens of diff content.
# This leaves room for the prompt + response within the context window.
MAX_CHUNK_CHARS=80000


# ==========================
# Database
# ==========================

# Path INSIDE the container. Mapped via docker-compose volume.
# Do not change unless you also change docker-compose.yml volumes.
DB_PATH=/data/reviews.db


# ==========================
# Logging
# ==========================

# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# ==========================
# Admin UI (GitLab OAuth)
# ==========================
# The admin dashboard requires GitLab OAuth for authentication.
#
# Setup steps:
#   1. Go to GitLab → User Settings → Applications (or Admin → Applications)
#   2. Create a new application:
#        Name: Code Review Bot
#        Redirect URI: http://<BOT_PC_IP>:8888/code-review-bot/callback
#        Scopes: read_user
#        Confidential: Yes
#   3. Copy the Application ID and Secret below.

# OAuth Application ID from GitLab
GITLAB_OAUTH_APP_ID=

# OAuth Application Secret from GitLab
GITLAB_OAUTH_APP_SECRET=

# Secret key for signing session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Base URL of THIS service as seen by the BROWSER (for OAuth callback).
# This must be reachable from the user's browser.
ADMIN_BASE_URL=http://<BOT_PC_IP>:8888

# GitLab URL as seen by the BROWSER (for OAuth redirects).
# Usually the same as GITLAB_URL unless GitLab uses a different address
# externally vs internally.
GITLAB_OAUTH_BASE_URL=http://<GITLAB_PC_IP>:<GITLAB_PORT>


# ==========================
# Emoji Re-trigger
# ==========================

# GitLab emoji name (without colons) that re-triggers a code review when added to a MR.
# Example: "repeat" = 🔄, "redo" = ♻️. Requires Emoji events enabled in webhook settings.
REVIEW_RETRIGGER_EMOJI=repeat