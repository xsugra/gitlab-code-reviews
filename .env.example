# ─────────────────────────────────────────────────────────────────
# Bootstrap configuration only.
#
# Everything else (GitLab URL/token, Ollama model & tuning, chunk size,
# webhook secret, re-trigger emoji) is configured in the admin UI at
#   /code-review-bot/settings
# and stored in the database. On first boot these are seeded from any
# matching env vars you set here, then the database owns them.
# ─────────────────────────────────────────────────────────────────

# --- Admin UI auth ---
# Password to sign in to the admin UI.
ADMIN_PASSWORD=change-me
# Secret key for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- Logging ---
# Applied once at startup (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# --- Database ---
# Path to SQLite file. The Docker volume mounts /data persistently.
DB_PATH=/data/reviews.db

# ─────────────────────────────────────────────────────────────────
# Optional first-boot seed values (otherwise set them in the UI).
# Safe to delete after the first run — the DB is the source of truth.
# ─────────────────────────────────────────────────────────────────
# GITLAB_URL=https://gitlab.example.com
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# GITLAB_WEBHOOK_SECRET=
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5-coder:14b-instruct-q8_0
# OLLAMA_NUM_CTX=32768
# OLLAMA_TEMPERATURE=0.2
# OLLAMA_TIMEOUT_S=1800
# MAX_CHUNK_CHARS=80000
# REVIEW_RETRIGGER_EMOJI=repeat
