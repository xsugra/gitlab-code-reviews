# --- GitLab ---
# Base URL of your self-hosted GitLab instance.
GITLAB_URL=https://gitlab.example.com
# Personal Access Token or Project Access Token with `api` scope.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# Optional. If set, must match the "Secret Token" configured on the GitLab webhook.
GITLAB_WEBHOOK_SECRET=

# GitLab Webhook Triggers (enable in GitLab webhook settings):
#   [x] Merge request events  — code review + auto-fill empty MR descriptions
#   [x] Push events           — review commits pushed directly to branches
#   [x] Pipeline events       — analyze failed CI/CD pipelines
#   [x] Work item events      — auto-triage new issues (labels + severity)
#   [x] Deployment events      — analyze failed/successful deployments
#   [x] Releases events       — generate release notes from merged MRs
#   [x] Tag push events       — generate release notes when a tag is pushed
#   [x] Emoji events          — re-trigger review when specific emoji is added to MR

# --- Ollama / LLM ---
# Inside docker-compose this is set to http://ollama:11434 automatically.
OLLAMA_URL=http://ollama:11434
# Pull the model first: `docker compose exec ollama ollama pull qwen2.5-coder:14b-instruct-q8_0`
# Or locally on your machine: `ollama pull qwen2.5-coder:14b-instruct-q8_0`
OLLAMA_MODEL=qwen2.5-coder:14b-instruct-q8_0
# Context window in tokens. Match the model. 32B coder models support 32k.
OLLAMA_NUM_CTX=32768
OLLAMA_TEMPERATURE=0.2
# Per-request timeout to Ollama in seconds. Large MRs on CPU can take a long time.
OLLAMA_TIMEOUT_S=1800

# --- Chunking ---
# Max characters per LLM input chunk. ~4 chars/token, so 80000 ~= 20k tokens of diff,
# leaving room for prompt + response inside a 32k context window.
MAX_CHUNK_CHARS=80000

# --- Database ---
# Path to SQLite file. Docker volume mounts /data persistently.
DB_PATH=/data/reviews.db

LOG_LEVEL=INFO

# --- Admin UI (GitLab OAuth) ---
# Register an OAuth application on your GitLab instance:
#   User Settings → Applications (or Admin → Applications)
#   Name: Code Review Bot
#   Redirect URI: http://<server-ip>:8888/code-review-bot/callback
#   Scopes: read_user
#   Confidential: Yes
# Leave empty to disable the admin UI.
GITLAB_OAUTH_APP_ID=
GITLAB_OAUTH_APP_SECRET=
# Secret key for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Base URL of this service (used to build OAuth callback URL).
ADMIN_BASE_URL=http://localhost:8888
# GitLab URL as seen by the BROWSER (for OAuth redirects).
# Only needed when GITLAB_URL uses a Docker-internal address (e.g. host.docker.internal).
# If unset, defaults to GITLAB_URL.
GITLAB_OAUTH_BASE_URL=

# --- Emoji Re-trigger ---
# GitLab emoji name (without colons) that re-triggers a code review when added to a MR.
# Example: "repeat" = 🔄, "redo" = ♻️. Requires Emoji events enabled in webhook settings.
REVIEW_RETRIGGER_EMOJI=repeat